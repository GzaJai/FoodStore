# Server
DEBUG=true

# Database (SQLite para desarrollo rápido)
DATABASE_URL=sqlite+aiosqlite:///./foodstore.db

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=604800

# Mercado Pago
# MERCADO_PAGO_ACCESS_TOKEN=TEST-...      # Sandbox (acepta HTTP)
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...   # Producci��n (exige HTTPS)
# MERCADO_PAGO_PUBLIC_KEY=TEST-...        # Public Key para el frontend SDK
# FRONTEND_URL=http://localhost:5174

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Uploads
UPLOAD_DIR=app/uploads
