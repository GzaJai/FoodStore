# ─── API ──────────────────────────────────────────────
# URL del backend (sin /api)
VITE_API_URL=http://localhost:3000

# ─── Mercado Pago ─────────────────────────────────────
# Public Key desde el Dashboard de Mercado Pago
# (TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_MP_PUBLIC_KEY=TEST-YOUR_PUBLIC_KEY_HERE

# ─── Tarjetas de prueba Mercado Pago (MLA) ────────────
# El nombre del titular determina el resultado del pago:
#   APRO  → Pago aprobado
#   OTHO  → Pago rechazado
#   CONT  → Pago pendiente
VITE_MP_TEST_CARD_NUMBER=5031755734530604
VITE_MP_TEST_CARD_EXPIRY=11/25
VITE_MP_TEST_CARD_CVV=123
VITE_MP_TEST_CARD_NAME=APRO
